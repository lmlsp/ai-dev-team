<!-- upgrade-modal.wxml — UI 设计 §4.8 升级弹窗 -->
<view class="modal-overlay" wx:if="{{visible}}" bindtap="onCancel">
  <view class="modal-card" catchtap="">
    <!-- 标题 -->
    <view class="modal-header">
      <text class="modal-title">🎉 {{i18nTitle}}</text>
      <text class="modal-level-name" wx:if="{{nextInfo}}">{{nextInfo.name}}</text>
    </view>

    <!-- 餐厅图片占位区 -->
    <view class="modal-image">
      <text class="modal-level-emoji">{{levelEmoji}}</text>
    </view>

    <!-- 描述 -->
    <text class="modal-desc" wx:if="{{nextInfo}}">{{nextInfo.description}}</text>

    <!-- 条件列表 -->
    <view class="modal-conditions" wx:if="{{nextInfo}}">
      <view class="modal-condition {{gold >= nextInfo.goldCost ? 'met' : ''}}">
        <text>🪙 {{i18nGoldCondition}}</text>
      </view>
      <view class="modal-condition {{rating >= nextInfo.minRating ? 'met' : ''}}">
        <text>⭐ {{i18nRatingCondition}}</text>
      </view>
    </view>

    <!-- 解锁内容 2 列网格 -->
    <view class="modal-unlocks" wx:if="{{unlockItems.length > 0}}">
      <text class="unlock-title">{{i18nUnlockTitle}}</text>
      <view class="unlock-grid">
        <view class="unlock-item" wx:for="{{unlockItems}}" wx:key="label">
          <text class="unlock-icon">{{item.icon}}</text>
          <text class="unlock-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 按钮区 -->
    <view class="modal-actions">
      <button class="btn-primary confirm-btn" bindtap="onConfirm" disabled="{{!canUpgrade}}">
        {{canUpgrade ? i18nConfirm : i18nNotReady}}
      </button>
      <button class="cancel-btn" bindtap="onCancel">{{i18nCancel}}</button>
    </view>
  </view>
</view>
