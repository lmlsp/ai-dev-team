/* upgrade-modal.wxss */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 48rpx 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.modal-title { font-size: var(--font-lg); font-weight: 700; margin-bottom: 16rpx; }
.modal-emoji { font-size: 72rpx; margin-bottom: 8rpx; }
.modal-name { font-size: var(--font-xl); font-weight: 700; margin-bottom: 8rpx; }
.modal-desc { font-size: var(--font-sm); color: var(--color-text-light); text-align: center; margin-bottom: 20rpx; }

.modal-conditions { width: 100%; display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 28rpx; }
.mc-item {
  padding: 14rpx 20rpx;
  background: #f9f9f9;
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
}
.mc-item.met { background: #E8F5E9; }

.modal-actions { display: flex; gap: 20rpx; width: 100%; }
.cancel-btn, .confirm-btn { flex: 1; height: 72rpx; line-height: 72rpx; font-size: var(--font-sm); }
