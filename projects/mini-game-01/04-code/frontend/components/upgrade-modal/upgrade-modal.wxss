/* upgrade-modal.wxss — UI 设计 §4.8 升级弹窗 */
@import '../../app.wxss';

/* ========== 遮罩层 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: var(--color-overlay, rgba(45, 24, 10, 0.5));
  z-index: var(--z-modal, 20);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease-out;
}

/* ========== 模态卡片 ========== */
.modal-card {
  width: 600rpx;               /* 300px */
  background: var(--color-bg-card, #FFFFFF);
  border-radius: var(--radius-lg, 32rpx);  /* 16px */
  box-shadow: var(--shadow-lg, 0 16rpx 64rpx rgba(45, 24, 10, 0.15));
  padding: var(--space-5) var(--space-4) var(--space-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  animation: scaleBounceIn 0.3s var(--ease-out-back, cubic-bezier(0.34, 1.56, 0.64, 1));
}

/* ========== 标题区 ========== */
.modal-header {
  text-align: center;
  margin-bottom: var(--space-3);
}
.modal-title {
  font-size: var(--font-h3, 36rpx);
  font-weight: var(--weight-bold, 700);
  color: var(--color-text, #2C1810);
  display: block;
}
.modal-level-name {
  font-size: var(--font-body, 30rpx);
  font-weight: var(--weight-medium, 500);
  color: var(--color-primary, #FF6B35);
  display: block;
  margin-top: var(--space-1);
}

/* ========== 餐厅图片占位区 ========== */
.modal-image {
  width: 360rpx;               /* 180px */
  height: 240rpx;              /* 120px */
  border-radius: var(--radius-sm, 16rpx);  /* 8px */
  background: linear-gradient(135deg, var(--color-primary-light, #FFF0E8), var(--color-bg-board, #F5E6D8));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-3);
}
.modal-level-emoji {
  font-size: 96rpx;
  line-height: 1;
}

/* ========== 描述 ========== */
.modal-desc {
  font-size: var(--font-caption, 24rpx);
  color: var(--color-text-secondary, #8B6F5F);
  text-align: center;
  margin-bottom: var(--space-3);
  line-height: 1.5;
}

/* ========== 条件列表 ========== */
.modal-conditions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}
.modal-condition {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
  background: #F9F6F2;
  border-radius: var(--radius-sm, 16rpx);
  font-size: var(--font-caption, 24rpx);
  color: var(--color-text, #2C1810);
}
.modal-condition.met {
  background: #E8F5E9;
  color: var(--color-success, #4CAF50);
}

/* ========== 解锁内容 ========== */
.modal-unlocks {
  width: 100%;
  margin-bottom: var(--space-4);
}
.unlock-title {
  font-size: var(--font-caption-bold, 24rpx);
  font-weight: var(--weight-medium, 500);
  color: var(--color-text-secondary, #8B6F5F);
  margin-bottom: var(--space-2);
}
.unlock-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-2);
}
.unlock-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) var(--space-2);
  background: var(--color-primary-light, #FFF0E8);
  border-radius: var(--radius-xs, 8rpx);
}
.unlock-icon {
  font-size: var(--font-caption, 24rpx);
  line-height: 1;
}
.unlock-label {
  font-size: var(--font-mini, 20rpx);
  color: var(--color-text, #2C1810);
}

/* ========== 按钮区 ========== */
.modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-1);
}
.modal-actions .confirm-btn {
  width: 100%;
}
.modal-actions .cancel-btn {
  width: auto;
  min-width: auto;
  background: transparent;
  color: var(--color-text-secondary, #8B6F5F);
  font-size: var(--font-caption, 24rpx);
  border: none;
  box-shadow: none;
  height: auto;
  line-height: 1;
  padding: var(--space-1) 0;
}
.modal-actions .cancel-btn:active {
  background: transparent;
  color: var(--color-text, #2C1810);
  transform: none;
}
