<!-- energy-bar.wxml -- UI 设计 §4.5 能量条 -->
<view class="energy-bar-container">
  <!-- 能量条轨道 -->
  <view class="energy-track {{percentage < 20 ? 'low' : ''}}">
    <!-- 填充条 -->
    <view class="energy-fill {{percentage < 20 ? 'low' : ''}}" style="width: {{percentage}}%">
      <!-- 流光边缘（满能量时隐藏） -->
      <view class="shimmer-edge" wx:if="{{percentage < 100 && percentage >= 20}}"></view>
    </view>
    <!-- ⚡ 图标 -->
    <text class="energy-icon">⚡</text>
    <!-- 数值 -->
    <text class="energy-number">{{current}}/{{max}}</text>
  </view>

  <!-- "+" 看广告按钮 -->
  <view class="energy-add-btn" wx:if="{{!isFull && dailyAdRemaining > 0}}" bindtap="onWatchAd">+</view>
</view>
