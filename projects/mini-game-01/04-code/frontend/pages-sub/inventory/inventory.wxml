<!--inventory.wxml - 背包-->
<view class="inv-container">
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack"><text class="back-icon">←</text></view>
    <text class="nav-title">背包</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="inv-list" scroll-y="true" wx:if="{{!empty}}">
    <view class="inv-item" wx:for="{{items}}" wx:key="id">
      <text class="inv-icon">{{item.icon}}</text>
      <view class="inv-info">
        <text class="inv-name">{{item.name}}</text>
        <text class="inv-desc">{{item.description}}</text>
      </view>
      <view class="inv-right">
        <text class="inv-count">×{{item.count}}</text>
        <button class="use-btn" data-id="{{item.id}}" bindtap="onUseItem" size="mini">使用</button>
      </view>
    </view>
  </scroll-view>

  <view class="empty-state" wx:if="{{empty}}">
    <text class="empty-emoji">🎒</text>
    <text class="empty-text">背包空空如也</text>
    <text class="empty-hint">完成订单和升级可获得道具奖励</text>
  </view>
</view>
