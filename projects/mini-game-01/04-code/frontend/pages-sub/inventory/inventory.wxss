/* inventory.wxss */
.inv-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}
.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
  flex-shrink: 0;
}
.nav-back { width: 80rpx; }
.back-icon { font-size: 40rpx; color: var(--color-text); }
.nav-title { font-size: var(--font-lg); font-weight: 700; }
.nav-placeholder { width: 80rpx; }

.inv-list { flex: 1; padding: 16rpx 24rpx; }
.inv-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  gap: 16rpx;
}
.inv-icon { font-size: 48rpx; }
.inv-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.inv-name { font-size: var(--font-md); font-weight: 600; }
.inv-desc { font-size: var(--font-xs); color: var(--color-text-light); }
.inv-right { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.inv-count { font-size: var(--font-sm); font-weight: 600; color: var(--color-primary); }
.use-btn { background: var(--color-primary); color: #fff; }

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.empty-emoji { font-size: 80rpx; }
.empty-text { font-size: var(--font-md); color: var(--color-text-light); }
.empty-hint { font-size: var(--font-xs); color: #ccc; }
