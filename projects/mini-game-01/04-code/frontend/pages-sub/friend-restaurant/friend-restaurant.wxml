<!--friend-restaurant.wxml - 好友餐厅-->
<view class="fr-container">
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack"><text class="back-icon">←</text></view>
    <text class="nav-title">{{friendInfo.nickName}}的餐厅</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="fr-content" scroll-y="true" wx:if="{{!loading && friendInfo}}">
    <!-- 餐厅信息 -->
    <view class="restaurant-hero">
      <text class="hero-emoji">{{friendInfo.restaurantLevel === 1 ? '🛒' : friendInfo.restaurantLevel === 2 ? '🏠' : friendInfo.restaurantLevel === 3 ? '🏪' : friendInfo.restaurantLevel === 4 ? '🏛️' : '👑'}}</text>
      <text class="hero-name">{{friendInfo.restaurantName}}</text>
      <text class="hero-level">Lv.{{friendInfo.restaurantLevel}}</text>
    </view>

    <!-- 数据 -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">⭐{{friendInfo.rating}}</text>
        <text class="stat-label">好评度</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">❤️{{friendInfo.likeCount}}</text>
        <text class="stat-label">获赞</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">👣{{friendInfo.visitCount}}</text>
        <text class="stat-label">被拜访</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions">
      <button class="btn-primary action-btn" bindtap="onVisit" disabled="{{visited}}">
        {{visited ? '已拜访 ✓' : '🔍 拜访获取灵感'}}
      </button>
      <button class="btn-secondary action-btn" bindtap="onLike" disabled="{{liked}}">
        {{liked ? '已点赞 ❤️' : '❤️ 点赞'}}
      </button>
    </view>

    <!-- 灵感提示 -->
    <view class="inspiration-tip" wx:if="{{visited && inspiration > 0}}">
      <text>✨ 获得 {{inspiration}} 点灵感值！灵感可用于加速食材生成</text>
    </view>
  </scroll-view>

  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
