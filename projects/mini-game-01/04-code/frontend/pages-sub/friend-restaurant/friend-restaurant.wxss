/* friend-restaurant.wxss */
.fr-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}
.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
  flex-shrink: 0;
}
.nav-back { width: 80rpx; }
.back-icon { font-size: 40rpx; color: var(--color-text); }
.nav-title { font-size: var(--font-lg); font-weight: 700; }
.nav-placeholder { width: 80rpx; }

.fr-content { flex: 1; padding: 24rpx; }

.restaurant-hero {
  background: linear-gradient(135deg, #FFF8F0, #FFE0C0);
  border-radius: var(--radius-lg);
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.hero-emoji { font-size: 100rpx; margin-bottom: 16rpx; }
.hero-name { font-size: var(--font-xl); font-weight: 700; margin-bottom: 8rpx; }
.hero-level { font-size: var(--font-md); color: var(--color-primary); }

.stats-row {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-value { font-size: var(--font-lg); font-weight: 600; }
.stat-label { font-size: var(--font-xs); color: var(--color-text-light); }

.actions { display: flex; flex-direction: column; gap: 16rpx; }
.action-btn { width: 100%; height: 88rpx; }

.inspiration-tip {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #FFF8E1;
  border-radius: var(--radius-md);
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.loading-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-light);
}
