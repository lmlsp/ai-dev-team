/* friends.wxss */
.friends-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}
.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
  flex-shrink: 0;
}
.nav-back { width: 80rpx; }
.back-icon { font-size: 40rpx; color: var(--color-text); }
.nav-title { font-size: var(--font-lg); font-weight: 700; }
.nav-placeholder { width: 80rpx; }

.friends-list {
  flex: 1;
  padding: 16rpx 24rpx;
}
.friend-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  gap: 16rpx;
}
.friend-avatar { font-size: 48rpx; }
.friend-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.friend-name { font-size: var(--font-md); font-weight: 600; }
.friend-restaurant { font-size: var(--font-xs); color: var(--color-text-light); }
.friend-rating { font-size: var(--font-xs); color: #FFD700; }
.friend-actions { display: flex; flex-direction: column; gap: 8rpx; }
.action-btn { font-size: 20rpx; padding: 4rpx 16rpx; }
.visit-btn { background: var(--color-primary); color: #fff; }
.energy-btn { background: #FFF0E0; color: var(--color-primary); }

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.empty-emoji { font-size: 80rpx; }
.empty-text { font-size: var(--font-md); color: var(--color-text-light); }

.loading-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-light);
}
