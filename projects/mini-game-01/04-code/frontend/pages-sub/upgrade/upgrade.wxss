/* upgrade.wxss */
.upgrade-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}
.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
  flex-shrink: 0;
}
.nav-back { width: 80rpx; }
.back-icon { font-size: 40rpx; color: var(--color-text); }
.nav-title { font-size: var(--font-lg); font-weight: 700; }
.nav-placeholder { width: 80rpx; }

.upgrade-content {
  flex: 1;
  padding: 24rpx;
}

.current-level-card, .next-level-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.section-title {
  font-size: var(--font-sm);
  color: var(--color-text-light);
  margin-bottom: 16rpx;
}
.level-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.level-emoji { font-size: 56rpx; }
.level-name { font-size: var(--font-xl); font-weight: 700; }
.level-badge {
  background: var(--color-primary);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: var(--font-xs);
}
.level-desc {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}
.next-level-card {
  border: 2rpx dashed var(--color-primary);
}

/* 条件 */
.conditions {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.condition {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: var(--radius-md);
}
.condition.met {
  background: #E8F5E9;
}
.condition-icon { font-size: 28rpx; }
.condition-text { flex: 1; font-size: var(--font-md); }
.condition-status { color: #4CAF50; font-weight: 700; }

/* 解锁预览 */
.unlock-preview {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #FFF8F0;
  border-radius: var(--radius-md);
}
.preview-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 12rpx;
}
.preview-list { display: flex; flex-direction: column; gap: 8rpx; }
.preview-item { font-size: var(--font-sm); color: var(--color-text); }

/* 升级按钮 */
.upgrade-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  font-size: var(--font-lg);
}
.upgrade-btn.disabled {
  background: #ccc;
  color: #999;
}

/* 满级 */
.max-level {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.max-emoji { font-size: 120rpx; margin-bottom: 24rpx; }
.max-text { font-size: var(--font-lg); color: var(--color-text-light); }
