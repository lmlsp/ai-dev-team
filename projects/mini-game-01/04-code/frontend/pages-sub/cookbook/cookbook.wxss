/* cookbook.wxss - 菜谱图鉴样式 */
.cookbook-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* 导航栏 */
.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
  flex-shrink: 0;
}
.nav-back {
  width: 80rpx;
}
.back-icon {
  font-size: 40rpx;
  color: var(--color-text);
}
.nav-title {
  font-size: var(--font-lg);
  font-weight: 700;
}
.nav-placeholder {
  width: 80rpx;
}

/* 进度条 */
.progress-section {
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.progress-text {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}
.progress-count {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-primary);
}
.progress-bar {
  height: 10rpx;
  background: #f0f0f0;
  border-radius: 5rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), #FFD700);
  border-radius: 5rpx;
  transition: width 0.5s;
}

/* 菜系筛选 */
.cuisine-filter {
  padding: 16rpx 24rpx;
  white-space: nowrap;
  background: #fff;
  flex-shrink: 0;
}
.filter-item {
  display: inline-flex;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: var(--font-sm);
  color: var(--color-text-light);
}
.filter-item.active {
  background: var(--color-primary);
  color: #fff;
}

/* 菜谱网格 */
.recipe-grid {
  flex: 1;
  padding: 16rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.recipe-card {
  width: calc(33.33% - 12rpx);
  aspect-ratio: 1;
  background: #fff;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
}
.recipe-card.locked {
  background: #f8f8f8;
  opacity: 0.6;
}
.recipe-emoji {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}
.recipe-name {
  font-size: var(--font-xs);
  color: var(--color-text);
  text-align: center;
}
.recipe-cuisine {
  font-size: 18rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}
.recipe-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  background: #FFD700;
  border-radius: 12rpx;
  padding: 2rpx 8rpx;
}
.badge-text {
  font-size: 16rpx;
  color: #fff;
  font-weight: 600;
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.detail-modal.show {
  opacity: 1;
  pointer-events: auto;
}
.detail-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
}
.detail-content {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.detail-emoji {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}
.detail-name {
  font-size: var(--font-xl);
  font-weight: 700;
  margin-bottom: 8rpx;
}
.detail-cuisine {
  font-size: var(--font-sm);
  color: var(--color-text-light);
  margin-bottom: 24rpx;
}
.detail-info {
  display: flex;
  gap: 40rpx;
  margin-bottom: 20rpx;
}
.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.detail-label {
  font-size: var(--font-xs);
  color: var(--color-text-light);
}
.detail-value {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}
.detail-story {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-style: italic;
  margin-bottom: 32rpx;
  text-align: center;
}
.close-btn {
  width: 200rpx;
}
