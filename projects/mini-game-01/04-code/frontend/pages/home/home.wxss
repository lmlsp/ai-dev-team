/* home.wxss - 主界面样式 */
.home-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
}

/* ========== 顶部状态栏 ========== */
.info-bar {
  height: 88rpx;
  padding: 10rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(255,255,255,0.85));
  backdrop-filter: blur(10px);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  z-index: 10;
  flex-shrink: 0;
}
.info-left {
  display: flex;
  align-items: center;
}
.user-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.user-avatar {
  font-size: 40rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg-dark);
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-detail {
  display: flex;
  flex-direction: column;
}
.restaurant-name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-level {
  font-size: var(--font-xs);
  color: var(--color-primary);
  font-weight: 500;
}

.info-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.resource-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 10rpx;
  background: var(--color-bg);
  border-radius: 20rpx;
}
.resource-icon {
  font-size: 22rpx;
}
.resource-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
}
.energy-item {
  position: relative;
}
.energy-plus {
  font-size: 16rpx;
  color: var(--color-primary);
  font-weight: 700;
  margin-left: 2rpx;
}

/* ========== Canvas 容器 ========== */
.canvas-container {
  flex: 1;
  position: relative;
  overflow: hidden;
}
.game-canvas {
  width: 100%;
  height: 100%;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  height: 112rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(0deg, rgba(255,255,255,0.98), rgba(255,255,255,0.9));
  backdrop-filter: blur(10px);
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
  flex-shrink: 0;
  padding: 0 10rpx;
}
.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-md);
  transition: all 0.15s;
}
.bar-btn:active {
  background: var(--color-bg-dark);
  transform: scale(0.93);
}
.bar-btn.active {
  background: var(--color-primary);
}
.bar-btn.active .bar-btn-text {
  color: #fff;
}
.bar-btn-icon {
  font-size: 36rpx;
}
.bar-btn-text {
  font-size: var(--font-xs);
  color: var(--color-text);
}

/* ========== Toast ========== */
.game-toast {
  position: fixed;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.75);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: var(--font-sm);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 999;
  white-space: nowrap;
}
.game-toast.show {
  opacity: 1;
}
