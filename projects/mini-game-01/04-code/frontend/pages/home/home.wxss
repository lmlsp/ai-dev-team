/* home.wxss - 主界面样式（§6 P2 布局） */
.home-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
}

/* ========== 顶部状态栏（§4.9） ========== */
.info-bar {
  height: 88rpx;
  padding: 10rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 248, 242, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 2rpx 0 #EDE4DA;
  z-index: 10;
  flex-shrink: 0;
}
.info-left {
  display: flex;
  align-items: center;
}
.user-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.user-avatar {
  font-size: 40rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F5E6D8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.user-detail {
  display: flex;
  flex-direction: column;
}
.restaurant-name {
  font-size: 28rpx;
  font-weight: var(--weight-medium);
  color: var(--color-text);
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-level {
  font-size: var(--font-caption);
  color: var(--color-primary);
  font-weight: var(--weight-semibold);
}

.info-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}
.resource-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 248, 242, 0.8);
  border-radius: 20rpx;
}
.resource-icon {
  font-size: 22rpx;
}
.resource-value {
  font-size: var(--font-caption-bold);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
}
.energy-item {
  position: relative;
}
.energy-plus {
  font-size: 16rpx;
  color: var(--color-primary);
  font-weight: 700;
  margin-left: 2rpx;
}

/* ========== Canvas 容器 ========== */
.canvas-container {
  flex: 1;
  position: relative;
  overflow: hidden;
}
.game-canvas {
  width: 100%;
  height: 100%;
}

/* ========== 底部操作栏（§4.10） ========== */
.bottom-bar {
  height: 112rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background: #3D2C1E;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
  padding: 0 0;
}
.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-sm);
  min-width: 120rpx;
  min-height: 80rpx;
  transition: transform 0.1s ease-out;
}
.bar-btn:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.9);
}
.bar-btn.active {
  background: rgba(255, 107, 53, 0.3);
}
.bar-btn.active .bar-btn-icon {
  color: #FFB347;
}
.bar-btn.active .bar-btn-text {
  color: #FFB347;
}
.bar-btn-icon {
  font-size: 36rpx;
  color: #FFFFFF;
}
.bar-btn-text {
  font-size: 20rpx;
  font-weight: var(--weight-regular);
  color: #C4B5AC;
}

/* ========== Toast ========== */
.game-toast {
  position: fixed;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(45, 24, 10, 0.85);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: var(--font-caption);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 999;
  white-space: nowrap;
}
.game-toast.show {
  opacity: 1;
}
