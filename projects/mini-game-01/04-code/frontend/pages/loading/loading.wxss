/* loading.wxss - 加载页样式 */
.loading-container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFE4C4 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.loading-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.08;
}
.bg-emoji {
  font-size: 600rpx;
}

/* Logo */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  z-index: 1;
}
.logo-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: bounce 2s infinite;
}
.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 12rpx;
}
.logo-subtitle {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}

/* 进度条 */
.progress-area {
  width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: rgba(255,107,53,0.15);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.progress-text {
  font-size: var(--font-sm);
  color: var(--color-text-light);
  margin-bottom: 8rpx;
}
.progress-percent {
  font-size: var(--font-xs);
  color: var(--color-text-light);
}

/* 错误区 */
.error-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.error-text {
  font-size: var(--font-md);
  color: var(--color-text-light);
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-bottom: 20rpx;
}
.skip-btn {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}

/* 版本号 */
.version-text {
  position: absolute;
  bottom: 60rpx;
  font-size: var(--font-xs);
  color: #ccc;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}
