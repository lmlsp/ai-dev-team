<!--tutorial.wxml - 新手引导-->
<view class="tutorial-container">
  <!-- 蒙层 -->
  <view class="tutorial-mask"></view>

  <!-- 高亮指示器 -->
  <view class="highlight-arrow {{step.highlight === 'board' ? 'point-board' : step.highlight === 'order' ? 'point-order' : 'point-bottom'}}">
    <text class="arrow-icon">👇</text>
  </view>

  <!-- 提示卡片 -->
  <view class="tip-card" style="{{tipStyle}}">
    <!-- 步骤指示器 -->
    <view class="step-indicator">
      <view class="step-dot {{index <= currentStep ? 'active' : ''}}" wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this"></view>
    </view>

    <text class="tip-title">{{step.title}}</text>
    <text class="tip-desc">{{step.desc}}</text>

    <view class="tip-actions">
      <text class="skip-btn" bindtap="onSkip">跳过引导</text>
      <button class="btn-primary next-btn" bindtap="onNext">
        {{isLast ? '开始烹饪！' : '下一步'}}
      </button>
    </view>
  </view>
</view>
