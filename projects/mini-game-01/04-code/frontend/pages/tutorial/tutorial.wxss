/* tutorial.wxss - 新手引导样式 */
.tutorial-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
}

/* 蒙层 */
.tutorial-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.65);
}

/* 箭头指示 */
.highlight-arrow {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bounce 1.5s infinite;
  z-index: 1001;
}
.point-board { top: 25%; left: 50%; }
.point-order { top: 80px; left: 50%; }
.point-bottom { bottom: 200px; left: 50%; }
.arrow-icon { font-size: 40rpx; }

/* 提示卡片 */
.tip-card {
  position: absolute;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow-lg);
  z-index: 1002;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-indicator {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.step-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.3s;
}
.step-dot.active {
  background: var(--color-primary);
  transform: scale(1.3);
}

.tip-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
  text-align: center;
}

.tip-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 28rpx;
  line-height: 1.6;
}

.tip-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.skip-btn {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  padding: 10rpx;
}
.next-btn {
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: var(--font-sm);
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}
