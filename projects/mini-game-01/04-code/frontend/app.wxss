/**
 * 合合小厨神 — 全局样式
 */

/* ========== CSS 变量（主题色） ========== */
page {
  --color-primary: #FF6B35;        /* 主色：暖橙 */
  --color-primary-dark: #E55A2B;   /* 主色深 */
  --color-primary-light: #FF8C5A;  /* 主色浅 */
  --color-secondary: #FFD700;      /* 辅色：金币黄 */
  --color-bg: #FFF8F0;             /* 背景：米白 */
  --color-bg-dark: #F5E6D3;       /* 背景深 */
  --color-text: #333333;           /* 主文字 */
  --color-text-light: #999999;     /* 辅助文字 */
  --color-success: #52C41A;        /* 成功绿 */
  --color-danger: #FF4D4F;         /* 危险红 */
  --color-warning: #FAAD14;        /* 警告黄 */
  --color-white: #FFFFFF;

  /* 字号 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-round: 50%;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.08);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.12);
  --shadow-lg: 0 8rpx 32rpx rgba(0,0,0,0.16);

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: var(--font-md);
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

/* ========== 通用按钮样式 ========== */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  padding: 16rpx 32rpx;
  font-size: var(--font-md);
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}
.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}
.btn-primary[disabled] {
  background: #ccc;
  color: #999;
}

.btn-secondary {
  background: var(--color-white);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  padding: 16rpx 32rpx;
  font-size: var(--font-md);
  text-align: center;
}
.btn-secondary:active {
  background: #FFF0E8;
}

.btn-ghost {
  background: transparent;
  color: var(--color-text-light);
  border: none;
  padding: 12rpx 24rpx;
  font-size: var(--font-sm);
}

/* ========== 通用布局 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-1 {
  flex: 1;
}

/* ========== 通用卡片 ========== */
.card {
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
}

/* ========== 文本工具类 ========== */
.text-center { text-align: center; }
.text-primary { color: var(--color-primary); }
.text-gold { color: var(--color-secondary); }
.text-light { color: var(--color-text-light); }
.text-sm { font-size: var(--font-sm); }
.text-md { font-size: var(--font-md); }
.text-lg { font-size: var(--font-lg); }
.text-xl { font-size: var(--font-xl); }
.text-bold { font-weight: 700; }

/* ========== Toast 动画 ========== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes bounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

/* ========== 安全区域适配 ========== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
