/**
 * 合合小厨神 — 全局样式
 * 按 UI 设计文档 v1.0 对齐：配色 / 字体 / 圆角 / 阴影 / 动效 / 安全区
 * 设计基准：iPhone 14 (390×844px)，1px = 2rpx
 */

/* ================================================================
   1. CSS 变量（主题色板 — 与 03-ui-design.md §2.1 完全对齐）
   ================================================================ */
page {
  /* 主色系 */
  --color-primary: #FF6B35;           /* 厨房橙 — 主按钮、合成高亮、CTA */
  --color-primary-dark: #E55A2B;      /* 焦糖 — 主按钮按下态 */
  --color-primary-light: #FFF0E8;     /* 奶油橙 — 棋盘选中高亮、标签背景 */

  /* 辅色系 */
  --color-secondary: #FFB347;         /* 蜂蜜金 — 金币图标、升级按钮、稀有菜品 */
  --color-secondary-dark: #E69520;    /* 琥珀 — 金币数字暗部 */

  /* 强调色 */
  --color-success: #4CAF50;           /* 鲜绿 — 上菜成功、合成成功粒子 */
  --color-danger: #FF5252;            /* 警示红 — 顾客超时、能量不足闪烁 */
  --color-info: #42A5F5;              /* 天蓝 — 链接、信息提示 */

  /* 文字色 */
  --color-text: #2C1810;              /* 深棕 — 标题、正文、重要信息 */
  --color-text-secondary: #8B6F5F;    /* 暖灰棕 — 辅助说明、时间戳、数值标签 */
  --color-text-disabled: #C4B5AC;     /* 浅褐 — 禁用状态文字、占位符 */

  /* 背景色 */
  --color-bg: #FFF8F2;                /* 暖白 — 主界面背景、页面底色 */
  --color-bg-card: #FFFFFF;           /* 纯白 — 卡片、弹窗、列表项 */
  --color-bg-board: #F5E6D8;          /* 木纹色 — Canvas 棋盘底板 */
  --color-bg-dark: #3D2C1E;           /* 深木色 — 底部栏、顶部状态栏背景 */

  /* 分割线 & 蒙层 */
  --color-divider: #EDE4DA;           /* 暖灰 — 列表分割、卡片边框 */
  --color-overlay: rgba(45, 24, 10, 0.5); /* 半透明深棕 — 弹窗/引导蒙层 */

  /* 纯色快捷 */
  --color-white: #FFFFFF;

  /* ========== 字体规格（§3.2） ========== */
  --font-h1: 56rpx;                   /* 28px Bold — 大标题 */
  --font-h2: 44rpx;                   /* 22px SemiBold — 页面标题 */
  --font-h3: 36rpx;                   /* 18px SemiBold — 区块标题 */
  --font-body: 30rpx;                 /* 15px Regular — 正文 */
  --font-body-bold: 30rpx;            /* 15px Medium — 强调正文 */
  --font-caption: 24rpx;              /* 12px Regular — 辅助文字 */
  --font-caption-bold: 24rpx;         /* 12px Medium — 按钮/标签文字 */
  --font-mini: 20rpx;                 /* 10px Regular — 角标/徽标 */
  --font-xs: 20rpx;                   /* 向后兼容旧代码 */
  --font-sm: 24rpx;                   /* 向后兼容旧代码 */
  --font-md: 28rpx;                   /* 向后兼容旧代码 */
  --font-lg: 32rpx;                   /* 向后兼容旧代码 */
  --font-xl: 36rpx;                   /* 向后兼容旧代码 */
  --font-xxl: 44rpx;                  /* 向后兼容旧代码 */

  --line-h1: 80rpx;                   /* 40px */
  --line-h2: 64rpx;                   /* 32px */
  --line-h3: 52rpx;                   /* 26px */
  --line-body: 44rpx;                 /* 22px */
  --line-caption: 36rpx;              /* 18px */
  --line-mini: 28rpx;                 /* 14px */

  /* 字重 */
  --weight-bold: 700;
  --weight-semibold: 600;
  --weight-medium: 500;
  --weight-regular: 400;

  /* ========== 圆角系统（§1.3） ========== */
  --radius-xs: 8rpx;                  /* 4px */
  --radius-sm: 16rpx;                 /* 8px */
  --radius-md: 24rpx;                 /* 12px */
  --radius-lg: 32rpx;                 /* 16px */
  --radius-xl: 48rpx;                 /* 24px */
  --radius-round: 50%;

  /* ========== 间距系统（§1.3，基准 4px） ========== */
  --space-1: 8rpx;                    /* 4px */
  --space-2: 16rpx;                   /* 8px */
  --space-3: 24rpx;                   /* 12px */
  --space-4: 32rpx;                   /* 16px */
  --space-5: 40rpx;                   /* 20px */
  --space-6: 48rpx;                   /* 24px */
  --space-8: 64rpx;                   /* 32px */

  /* ========== 阴影系统（§1.3） ========== */
  --shadow-sm: 0 4rpx 16rpx rgba(45, 24, 10, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(45, 24, 10, 0.08);
  --shadow-lg: 0 16rpx 64rpx rgba(45, 24, 10, 0.15);
  --shadow-cell: 0 4rpx 12rpx rgba(45, 24, 10, 0.08);
  --shadow-drag: 0 8rpx 32rpx rgba(45, 24, 10, 0.2);

  /* ========== Z-Index 分层（§1.3） ========== */
  --z-content: 0;
  --z-float: 10;
  --z-modal: 20;
  --z-tutorial: 30;
  --z-toast: 40;

  /* ========== 全局基础 ========== */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  font-size: var(--font-body);
  line-height: var(--line-body);
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* ================================================================
   2. 按钮规范（§4.4）
   ================================================================ */

/* 主按钮 — 280×48px 设计基准，圆角全圆 24px */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 560rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #FF6B35;
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-xl);
  font-size: var(--font-body);
  font-weight: var(--weight-medium);
  text-align: center;
  box-shadow: var(--shadow-sm);
  padding: 0 var(--space-4);
  box-sizing: border-box;
  transition: transform 0.1s ease-out, background 0.1s ease-out;
}
.btn-primary:active {
  background: #E55A2B;
  transform: scale(0.96);
}
.btn-primary[disabled] {
  background: #EDE4DA;
  color: #C4B5AC;
  box-shadow: none;
}

/* 次按钮 — 白底 + 主色边框 */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 560rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #FFFFFF;
  color: #FF6B35;
  border: 3rpx solid #FF6B35;
  border-radius: var(--radius-xl);
  font-size: var(--font-body);
  font-weight: var(--weight-medium);
  text-align: center;
  padding: 0 var(--space-4);
  box-sizing: border-box;
  transition: transform 0.1s ease-out;
}
.btn-secondary:active {
  background: #FFF0E8;
  color: #E55A2B;
  transform: scale(0.96);
}

/* 广告按钮 — 蜂蜜金底 */
.btn-ad {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #FFB347;
  color: #FFFFFF;
  border: none;
  border-radius: 40rpx;
  font-size: var(--font-caption-bold);
  font-weight: var(--weight-medium);
  text-align: center;
  box-shadow: var(--shadow-sm);
  padding: 0 var(--space-3);
  box-sizing: border-box;
  transition: transform 0.1s ease-out;
}
.btn-ad:active {
  background: #E69520;
  transform: scale(0.96);
}

/* 小按钮 */
.btn-sm {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #FF6B35;
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-lg);
  font-size: var(--font-caption-bold);
  font-weight: var(--weight-medium);
  text-align: center;
  padding: 0 var(--space-2);
  box-sizing: border-box;
  transition: transform 0.1s ease-out;
}
.btn-sm:active {
  background: #E55A2B;
  transform: scale(0.96);
}

/* 图标按钮 */
.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: transparent;
  color: #8B6F5F;
  border: none;
  border-radius: var(--radius-md);
  font-size: var(--font-h3);
  padding: 0;
}

/* 通用按钮最小点击区域 44×44px = 88rpx */
button {
  min-width: 88rpx;
  min-height: 88rpx;
}
button::after {
  border: none;
}

/* ================================================================
   3. 通用布局
   ================================================================ */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

/* ================================================================
   4. 通用卡片
   ================================================================ */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  padding: var(--space-6);
}

/* ================================================================
   5. 文本工具类
   ================================================================ */
.text-center { text-align: center; }
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-secondary); }
.text-secondary-light { color: var(--color-text-secondary); }
.text-disabled { color: var(--color-text-disabled); }

.text-h1 { font-size: var(--font-h1); line-height: var(--line-h1); font-weight: var(--weight-bold); }
.text-h2 { font-size: var(--font-h2); line-height: var(--line-h2); font-weight: var(--weight-semibold); }
.text-h3 { font-size: var(--font-h3); line-height: var(--line-h3); font-weight: var(--weight-semibold); }
.text-body { font-size: var(--font-body); line-height: var(--line-body); font-weight: var(--weight-regular); }
.text-body-bold { font-size: var(--font-body-bold); line-height: var(--line-body); font-weight: var(--weight-medium); }
.text-caption { font-size: var(--font-caption); line-height: var(--line-caption); font-weight: var(--weight-regular); }
.text-caption-bold { font-size: var(--font-caption-bold); line-height: var(--line-caption); font-weight: var(--weight-medium); }
.text-mini { font-size: var(--font-mini); line-height: var(--line-mini); font-weight: var(--weight-regular); }

.text-bold { font-weight: var(--weight-bold); }
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ================================================================
   6. 动效关键帧（§7.2 — 精确 cubic-bezier 参数）
   ================================================================ */

/* fadeIn — 弹窗蒙层入场 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* scale-bounce — 弹窗卡片入场 ease-out-back */
@keyframes scaleBounceIn {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes scaleBounceOut {
  from { opacity: 1; transform: scale(1); }
  to { opacity: 0; transform: scale(0.9); }
}

/* slide-up — 底部弹出 */
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* breathe — 高亮呼吸发光（引导蒙层高亮区） */
@keyframes breathe {
  0% { box-shadow: 0 0 0 0 rgba(255, 107, 53, 0.4); }
  100% { box-shadow: 0 0 0 16rpx rgba(255, 107, 53, 0); }
}

/* shimmer — 能量恢复流光 */
@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

/* shake — 顾客超时抖动 */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}

/* blink — 能量不足闪烁 */
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* floatUp — 金币飘字 */
@keyframes floatUp {
  0% { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(-80rpx) scale(1.2); }
}

/* pulse — 点赞爱心 */
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.5); }
  100% { transform: scale(1); }
}

/* spin — 加载旋转 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* rainbow-rotate — Lv.4 稀有菜边框旋转 */
@keyframes rainbowRotate {
  from { filter: hue-rotate(0deg); }
  to { filter: hue-rotate(360deg); }
}

/* ================================================================
   7. 缓动函数工具类（CSS 变量形式供组件引用）
   ================================================================ */
page {
  --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-in: cubic-bezier(0.55, 0.06, 0.68, 0.19);
  --ease-in-out: cubic-bezier(0.42, 0, 0.58, 1);
  --ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-linear: linear;
}

/* ================================================================
   8. 安全区域适配（§9.3）
   ================================================================ */
.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部状态栏半透明背景 — 沉浸式设计 */
.status-bar-bg {
  background: rgba(255, 248, 242, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

/* ================================================================
   9. Z-Index 快捷
   ================================================================ */
.z-content { z-index: 0; }
.z-float { z-index: 10; }
.z-modal { z-index: 20; }
.z-tutorial { z-index: 30; }
.z-toast { z-index: 40; }
